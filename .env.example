PHONE_NUMBER_ID=
KAPSO_API_KEY=
WABA_ID=

# Auth. AUTH_SECRET: random string, at least 32 chars (e.g. `openssl rand -base64 48`).
AUTH_SECRET=
# Public URL of the app, used for the CSRF Origin check (required in production).
APP_ORIGIN=
# SQLite user DB directory (Coolify: persistent volume mounted at /app/data).
DATA_DIR=./data
# First-start admin, only used if no active admin exists. Hash: `npm run hash-password`.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional display name for the bootstrap admin.
ADMIN_NAME=
