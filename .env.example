PHONE_NUMBER_ID=
KAPSO_API_KEY=
WABA_ID=

# Auth. AUTH_SECRET: random string, at least 32 chars (e.g. `openssl rand -base64 48`).
AUTH_SECRET=
# Public URL of the app, used for the CSRF Origin check (required in production).
APP_ORIGIN=
# SQLite user DB directory (Coolify: persistent volume mounted at /app/data).
DATA_DIR=./data
# First-start admin, only used if no active admin exists. Hash: `npm run hash-password`.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional display name for the bootstrap admin.
ADMIN_NAME=

# --- P-009: own store / Meta direct (see CUTOVER.md) ---
# kapso (default, today) | local (our webhook + DB + Meta Graph). Rollback = set back to kapso.
INBOX_SOURCE=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# Default ${DATA_DIR}/media
MEDIA_DIR=
# Media tiering (scripts/media-tier.mts, nightly). Files older than MEDIA_HOT_DAYS move from MEDIA_DIR to a PRIVATE bucket
# (GCS via S3-compatible HMAC keys). Leave the bucket vars empty to disable tiering (all media stays local).
# Separate bucket from backups. URL is path-style, no trailing slash, e.g. https://storage.googleapis.com/<bucket-name>
MEDIA_BUCKET_URL=
MEDIA_BUCKET_ACCESS_KEY_ID=
MEDIA_BUCKET_SECRET_ACCESS_KEY=
# GCS ignores the region in the signature; default auto (same as backup.sh)
MEDIA_BUCKET_REGION=auto
MEDIA_HOT_DAYS=7
# Alerts: email via Resend (preferred) and/or a JSON webhook. At least one is required in production.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_RESEND_API_KEY=
ALERT_WEBHOOK_URL=
# Nightly backup (scripts/backup.sh) to a dedicated GCS bucket via HMAC keys
BACKUP_TARGET_URL=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=
BACKUP_PASSPHRASE=
